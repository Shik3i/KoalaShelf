{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# Audiobookshelf API, auth, websockets and streams go to the server.
	@abs path /api/* /auth/* /logout /status /socket.io/* /hls/* /public/* /feed/*
	@login {
		method POST
		path /login
	}
	handle @abs {
		reverse_proxy {$ABS_URL}
	}
	handle @login {
		reverse_proxy {$ABS_URL}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		# No framing by other sites (clickjacking); a CSP <meta> tag cannot say this.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		-Server
	}

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@sw path /service-worker.js /index.html /
	header @sw Cache-Control "no-cache"
	# Small unhashed files: a day fresh, then revalidated in the background.
	@static path /theme.js /favicon.svg /icons/* /worklets/* /manifest.webmanifest /robots.txt
	header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Tells the app which Audiobookshelf server this proxy serves (prefilled in the sign-in form).
	handle /koalashelf.json {
		header Content-Type application/json
		header Cache-Control no-cache
		respond `{"server":"{$ABS_PUBLIC_URL}"}` 200
	}

	# Everything else is the SPA.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
