{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KoalaShelf",
  "version": "0.1.0",
  "identifier": "net.koalastuff.koalashelf",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @koalashelf/web dev --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @koalashelf/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KoalaShelf",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#17130F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "KoalaShelf",
    "category": "Music",
    "shortDescription": "Private client for Audiobookshelf"
  }
}
