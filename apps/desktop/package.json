{
  "name": "@koalashelf/desktop",
  "version": "1.1.1",
  "description": "KoalaShelf Desktop – private client for Audiobookshelf",
  "author": "KoalaShelf Contributors <contact@koalashelf.dev>",
  "homepage": "https://github.com/Shik3i/KoalaShelf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc && electron-builder",
    "pack": "tsc && electron-builder --dir",
    "compile": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "electron-builder": "electron-builder",
    "test": "electron test/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.17.0",
    "typescript": "^6.0.3"
  }
}
