# KoalaShelf configuration example: copy to .env next to docker-compose.yml.

# Where the container reaches Audiobookshelf. Examples:
#   http://audiobookshelf:80          a service on the same Docker network (default)
#   http://192.168.1.20:13378         Audiobookshelf elsewhere in your network
#   https://audiobooks.example.org    its public address
ABS_URL=http://audiobookshelf:80

# Optional: the address your listeners know Audiobookshelf by. It is prefilled in the sign-in
# form; signing in to it goes through KoalaShelf (same origin, no CORS setup needed).
# Listeners can always add any other Audiobookshelf server in the app as well.
ABS_PUBLIC_URL=

# Image version: latest, or pinned (e.g. 0.1.0 or 0.1) for predictable updates.
KOALASHELF_VERSION=latest

# Where the container listens on this host. 127.0.0.1 keeps it reachable only for a reverse
# proxy on the same machine; use 0.0.0.0 only if something else in your network proxies it.
KOALASHELF_BIND=127.0.0.1
KOALASHELF_PORT=8080
